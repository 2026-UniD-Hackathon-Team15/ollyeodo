# ===== 서버 전용 (프론트·Git에 절대 넣지 않음) =====
# Supabase 대시보드 > Connect > Session pooler
SUPABASE_DB_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=replace_me

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=images
# local: uploads/ 폴더에 저장 (Supabase 없이 개발) / supabase: Storage 비공개 버킷 사용
APP_STORAGE_TYPE=supabase

# 비전 AI (미정: OpenAI / Gemini / Claude 중 하나)
AI_API_KEY=replace_me
AI_MODEL=replace_me

# 판정 기준일 기본 타임존
APP_TIMEZONE=Asia/Seoul

# ===== 프론트엔드 =====
# 백엔드 API 주소
FRONTEND_API_BASE_URL=http://localhost:8080
